diff --git a/css/style.css b/css/style.css
index f52fea1..c6da1f5 100644
--- a/css/style.css
+++ b/css/style.css
@@ -883,7 +883,7 @@ tr:hover {
                  font-size:1em; font-family:inherit; box-sizing:border-box; }
 .lc-field:focus{ outline:none; border-color:var(--main-color); }
 .lc-meta       { color:#888; font-size:.9em; margin:.6em 0 1em; }
-.lc-scroll     { overflow-x:auto; border:1px solid #e3d7d7; border-radius:.5em; }
+.lc-scroll     { max-width:100%; overflow-x:auto; border:1px solid #e3d7d7; border-radius:.5em; }
 .lc-table      { border-collapse:collapse; width:100%; font-size:.9em; white-space:nowrap; }
 .lc-table th,
 .lc-table td   { padding:.5em .7em; border-bottom:1px solid #e3d7d7; text-align:left; }
@@ -897,9 +897,6 @@ tr:hover {
 .lc-role       { color:var(--main-color); font-weight:bold; }
 .lc-hint       { color:#999; padding:1em 0; }
 .lc-hidden     { display:none; }
-.lc-scroll { max-width: 100%; overflow-x: auto; }
-#lc-browse,
-#lc-search      { min-width: 0; max-width: 100%; }
 /* --- Bouton & formulaire « Suggérer une modification » --- */
 .lc-actions        { display:flex; align-items:center; flex-wrap:wrap; gap:.6em 1em; margin:1.6em 0 .4em; }
 .lc-btn            { padding:.55em 1.1em; border:2px solid var(--derive-main-color); border-radius:.5em;
@@ -961,7 +958,7 @@ tr:hover {
     padding: clamp(3rem, 7vw, 6rem) 1.5rem clamp(4rem, 8vw, 7rem);
 }
 .accueil__inner {
-    max-width: 1180px;
+    max-width: var(--largeur-max);
     margin: 0 auto;
 }
 
@@ -1091,7 +1088,9 @@ tr:hover {
     /* Rythme */
     --gap-section: clamp(3rem, 7vw, 6rem);
     --pad-carte:   clamp(1.5rem, 4vw, 3rem);
-    --largeur-max: 1180px;
+    /* Fluide : 1180px reste le plancher, on récupère de la place au-delà de
+       ~1440px au lieu de laisser deux marges vides de 700px sur un grand écran. */
+    --largeur-max: clamp(1180px, 82vw, 1560px);
 }
 
 body { background: var(--fond); color: var(--encre); }
@@ -1172,11 +1171,19 @@ body { background: var(--fond); color: var(--encre); }
     max-width: var(--largeur-max);
     margin: 0 auto;
     display: grid;
-    grid-template-columns: 260px 1fr;
+    /* minmax(0, 1fr) et non 1fr : le minimum automatique d'une piste vaut le
+       min-content de son contenu, et .lc-table est en white-space: nowrap.
+       Sans cette borne, la piste prend la largeur du tableau déplié et pousse
+       toute la grille hors de son max-width. */
+    grid-template-columns: 260px minmax(0, 1fr);
     gap: 3rem;
     align-items: start;
 }
 
+/* Même raison, au niveau de l'élément de grille : sans min-width: 0 il refuse
+   de descendre sous la taille de son contenu et .lc-scroll ne peut pas défiler. */
+.page__contenu { min-width: 0; }
+
 .theme { margin-bottom: 3.5rem; }
 .theme:last-child { margin-bottom: 0; }
 
@@ -1652,4 +1659,26 @@ body.zoom-ouvert { overflow: hidden; }
     .zoom__nav--prec { left: 25%; }
     .zoom__nav--suiv { right: 25%; }
     .zoom__legende { font-size: .9rem; }
-}
\ No newline at end of file
+}
+
+
+/* -----------------------------------------------------------------------------
+   GRANDS ÉCRANS
+   Tout le gabarit est pensé pour 1180px. Au-delà, on redonne de la place au
+   contenu plutôt que d'élargir les marges vides.
+   -------------------------------------------------------------------------- */
+@media (min-width: 1500px) {
+    .page__inner {
+        grid-template-columns: 300px minmax(0, 1fr);
+        gap: 4rem;
+    }
+    .sommaire__liste a { font-size: 1rem; }
+
+    /* Le pied de page suivait sa propre largeur, désalignée du reste. */
+    .footer-cols { max-width: var(--largeur-max); }
+}
+
+/* Au-delà, c'est la distance de lecture qui change, pas la mise en page. */
+@media (min-width: 1900px) {
+    html { font-size: 17px; }
+}
